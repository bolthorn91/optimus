# Copiar a .env y rellenar. .env nunca se commitea (perfil §7 I8).
# Solo claves VITE_*: todo lo que esté aquí acaba en el bundle del cliente, así que
# ningún valor puede ser secreto.

# EmailJS — envío del formulario de reserva (documento 06).
# Las tres son públicas por diseño: EmailJS las expone en el cliente.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Base absoluta del sitio, sin barra final. Necesaria para canonical y sitemap (documento 07).
# Sin este valor no se genera sitemap: una base falsa es peor que ninguna.
VITE_SITE_URL=

# Destino cookieless de los eventos G7 (documento 07). Público por diseño: va en el bundle.
# Sin este valor no se envía medición; no se inventa un colector.
VITE_ANALYTICS_ENDPOINT=

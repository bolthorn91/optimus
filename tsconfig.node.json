{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "tooling/**/*.ts",
    "tooling/**/*.js",
    "scripts/**/*.mjs"
  ]
}
